{
  "name": "cpl-dateline-cleveland",
  "version": "0.1.0",
  "private": true,
  "description": "Dateline Cleveland — print-native archive enrichment + discovery. Monorepo: apps/pipeline (image → VLM → structured content-objects) and apps/discovery (patron discovery SPA + staff workbench).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "view": "npm run view --workspace @dateline/pipeline",
    "catalog": "npm run catalog --workspace @dateline/pipeline",
    "server": "npm run server --workspace @dateline/pipeline",
    "enrich": "npm run enrich --workspace @dateline/pipeline",
    "export-real": "npm run export-real --workspace @dateline/discovery",
    "export-staff": "npm run export-staff --workspace @dateline/discovery",
    "export-all": "npm run export-all --workspace @dateline/discovery",
    "dev": "npm run dev --workspace @dateline/discovery",
    "build": "npm run build --workspace @dateline/discovery",
    "preview": "npm run preview --workspace @dateline/discovery"
  }
}
