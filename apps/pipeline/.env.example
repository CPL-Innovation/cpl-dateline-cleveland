# Dateline Cleveland pipeline — environment (copy to .env; .env is gitignored).
# All optional: the default `fixture` provider replays the session-VLM transcription
# and needs no key. Set a provider + its key only for a real batch run.

# Which VLM to use: fixture (default) | gemini | anthropic | openai
# VLM_PROVIDER=fixture

# Override the model for the chosen provider (re-verify current models before spend).
# VLM_MODEL=

# Long-edge px to downscale page images to before a live VLM call.
# VLM_MAX_EDGE=2200

# Point the harvester at a different page-image folder (defaults to ./inbox).
# INBOX_DIR=

# Provider keys — set only the one matching VLM_PROVIDER.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
