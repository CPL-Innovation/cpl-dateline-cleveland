# Dateline Cleveland pipeline — environment (copy to .env; .env is gitignored).
# All optional: the default `fixture` provider replays the session-VLM transcription
# and needs no key. Set a provider + its key only for a real batch run.

# Which VLM to use: fixture (default) | gemini | anthropic | openai
# VLM_PROVIDER=fixture

# Override the model for the chosen provider (re-verify current models before spend).
# VLM_MODEL=

# Long-edge px to downscale page images to before a live VLM call.
# VLM_MAX_EDGE=2200

# Point the harvester at a different page-image folder (defaults to ./inbox).
# INBOX_DIR=

# The patron reading-room assistant (THE STACKS chat). Needs ANTHROPIC_API_KEY;
# without one the chat panel reports itself unavailable and nothing else breaks.
# CHAT_MODEL=claude-sonnet-5
# CHAT_MAX_TURNS=20              # questions per conversation (server-enforced)
# CHAT_MAX_CORPUS_CHARS=160000   # cap on one issue's published text in the prompt

# Your Edition, read aloud (SLICE-16). Model, voices, the patron switch and the
# Gemini key are set in the workbench (step 09 · Podcast audio); GEMINI_API_KEY
# below is the fallback key when the workbench hasn't saved one. These are defaults.
# PODCAST_TTS_MODEL=gemini-3.8-flash-tts
# PODCAST_SCRIPT_MODEL=claude-sonnet-5   # defaults to CHAT_MODEL
# PODCAST_CONCURRENCY=2                  # episodes recorded at once, server-wide
# PODCAST_TTS_CONCURRENCY=3              # segments of one episode voiced at once

# Provider keys — set only the one matching VLM_PROVIDER.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
